{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": [
      "bun-types"
    ],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "bin",
    "src",
    "test"
  ]
}
